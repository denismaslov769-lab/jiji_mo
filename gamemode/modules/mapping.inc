#define MAP_DD 220.0

stock Map_Sign(model, Float:x, Float:y, Float:z, Float:rz, text[], size, color, bg)
{
    new o = CreateObject(model, x, y, z, 0.0, 0.0, rz, MAP_DD);
    SetObjectMaterialText(o, text, 0, OBJECT_MATERIAL_SIZE_512x256, "Arial", size, 1, color, bg, OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
    return o;
}

